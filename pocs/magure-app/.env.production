# Production Environment Configuration
# Copy this file to .env for production deployment
# IMPORTANT: Change all default values before deploying!

# Environment
ENVIRONMENT=production
DEBUG=false

# Database Configuration (Update with your production database)
DB_NAME=maglabs_prod
DB_USER=maglabs_prod
DB_PASSWORD=CHANGE_ME_PRODUCTION_DB_PASSWORD
DB_HOST=postgres
DB_PORT=5432

# Django Settings (IMPORTANT: Generate a new secret key!)
SECRET_KEY=CHANGE_ME_PRODUCTION_SECRET_KEY_VERY_LONG_AND_RANDOM_STRING
ALLOWED_HOSTS=yourdomain.com,*.yourdomain.com,api.yourdomain.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com

# MagLabs API Configuration
MAGLABS_API_URL=https://api.maglabs.com
MAGLABS_API_KEY=CHANGE_ME_PRODUCTION_MAGLABS_API_KEY

# Frontend Configuration
FRONTEND_API_URL=https://yourdomain.com/api
FRONTEND_WS_URL=wss://yourdomain.com/ws

# AWS Configuration
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=maglabs-production-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com
AWS_CLOUDFRONT_DOMAIN=cdn.yourdomain.com
USE_S3=true

# AWS RDS Configuration (for docker-compose.aws.yml)
AWS_RDS_HOST=maglabs-prod.cluster-xyz.us-east-1.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DB_NAME=maglabs_prod
AWS_RDS_USERNAME=maglabs_prod
AWS_RDS_PASSWORD=CHANGE_ME_AWS_RDS_PASSWORD

# AWS Region
AWS_DEFAULT_REGION=us-east-1

# Email Configuration (AWS SES)
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_SES_SMTP_USERNAME
EMAIL_HOST_PASSWORD=CHANGE_ME_SES_SMTP_PASSWORD
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_REGION_NAME=us-east-1

# Monitoring and Error Tracking
SENTRY_DSN=CHANGE_ME_SENTRY_DSN_URL
FRONTEND_SENTRY_DSN=CHANGE_ME_FRONTEND_SENTRY_DSN

# AWS X-Ray Tracing
AWS_XRAY_TRACING_NAME=maglabs-production

# Primary Domain for Multi-tenant
PRIMARY_DOMAIN=yourdomain.com

# AWS ALB DNS (if using)
AWS_ALB_DNS=maglabs-alb-123456789.us-east-1.elb.amazonaws.com

# SSL Certificates (if not using ALB)
SSL_CERT_PATH=/etc/nginx/ssl/yourdomain.com.crt
SSL_KEY_PATH=/etc/nginx/ssl/yourdomain.com.key

# Performance Settings
GUNICORN_WORKERS=4

# Security Settings
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# Logging
LOG_LEVEL=INFO

# Multi-tenant Production Domains
TENANT_DOMAINS=tenant1.yourdomain.com,tenant2.yourdomain.com,demo.yourdomain.com

# Rate Limiting
RATE_LIMIT_ENABLE=true
RATE_LIMIT_PER_MINUTE=100
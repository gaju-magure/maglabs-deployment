# =============================================================================
# DJANGO CORE CONFIGURATION
# =============================================================================

# Django secret key - CHANGE THIS IN PRODUCTION!
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-long-and-random

# Debug mode - set to False in production
DJANGO_DEBUG=True

# Allowed hosts - restrict in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.maglabs.api,*.maglabs.local

# Environment type (dev/production)
DJANGO_ENV=dev

# Application port
PORT=8000

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL + django-tenants)
# =============================================================================

POSTGRES_DB=maglab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Development: Console backend (emails printed to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MagLabs <noreply@maglabs.com>

# Production: SMTP backend (uncomment and configure for real email sending)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=MagLabs <noreply@yourdomain.com>

# Alternative: SendGrid SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=MagLabs <noreply@yourdomain.com>

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Frontend URLs that can access the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost:3000

# =============================================================================
# AI SERVICES CONFIGURATION
# =============================================================================

# OpenAI API key for AI-powered features
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# AI service URL (if using external AI service)
AI_SERVICE_URL=http://localhost:8001/v1/chat/completions

# =============================================================================
# DEVELOPMENT/DEBUG CONFIGURATION (Optional)
# =============================================================================

# Enable VSCode debugpy for debugging (uncomment for debugging)
# DEBUGPY_ENABLE=1

# Ensure Python output is not buffered (useful for Docker)
# PYTHONUNBUFFERED=1

# =============================================================================
# PRODUCTION OVERRIDES (Set these in production .env)
# =============================================================================

# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourdomain.com,*.yourdomain.com
# DJANGO_SECRET_KEY=super-long-random-production-secret-key
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# POSTGRES_HOST=your-production-db-host
# POSTGRES_PASSWORD=your-secure-production-password

# =============================================================================
# NOTES
# =============================================================================

# 1. REQUIRED VARIABLES:
#    - DJANGO_SECRET_KEY (change from default!)
#    - OPENAI_API_KEY (for AI features)
#    - Production: EMAIL_* settings for real email sending
#    - Production: Secure POSTGRES_PASSWORD

# 2. OPTIONAL VARIABLES:
#    - All others have sensible defaults

# 3. TENANT ONBOARDING:
#    - Emails will print to console by default (EMAIL_BACKEND=console)
#    - Configure SMTP settings above for real email delivery
#    - Onboarding links: https://{tenant}.yourdomain.com/onboarding/{token}

# 4. MULTI-TENANCY:
#    - Each tenant gets its own PostgreSQL schema
#    - Domains: {tenant}.maglabs.api (or your domain)
#    - Public schema stores tenant/user management

# 5. DEVELOPMENT SETUP:
#    - Copy this file to .env
#    - Update DJANGO_SECRET_KEY
#    - Set OPENAI_API_KEY if using AI features
#    - Run: python manage.py migrate
#    - Run: python bootstrap.py (sets up initial tenants)
#    - Run: python manage.py runserver
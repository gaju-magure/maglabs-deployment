# Environment variables for the Python FastAPI backend

# Application Configuration
APP_ENV="development" # "development", "staging", "production"
LOG_LEVEL="INFO" # "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
PYTHONPATH="." # Ensures 'app' module can be found

# Supabase Configuration
# Replace with your actual Supabase project details
# For local development using 'supabase start', these will be different.
SUPABASE_URL="https://zsqigchbodazahqexxbo.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY" # Public anonymous key
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY" # Secret service role key, keep secure!
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET" # Used for verifying JWTs, found in Supabase project settings

# Google Gemini API Configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY" # Your Google AI Studio API Key

# FastAPI Server Configuration (defaults are usually fine)
# HOST="0.0.0.0"
# PORT="8000"

# CORS Configuration (defaults allow all for development)
# ALLOWED_ORIGINS='["http://localhost:5173", "http://localhost:3000", "https://your-frontend-domain.com"]' # JSON string array

# Optional: Sentry for error tracking
# SENTRY_DSN="YOUR_SENTRY_DSN"

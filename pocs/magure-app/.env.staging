# Staging Environment Configuration
# Copy this file to .env for staging deployment

# Environment
ENVIRONMENT=staging
DEBUG=false

# Database Configuration
DB_NAME=maglabs_staging
DB_USER=maglabs_staging
DB_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
DB_HOST=postgres
DB_PORT=5432

# Django Settings
SECRET_KEY=CHANGE_ME_STAGING_SECRET_KEY_VERY_LONG_AND_RANDOM_STRING
ALLOWED_HOSTS=staging.yourdomain.com,*.staging.yourdomain.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,https://*.staging.yourdomain.com

# MagLabs API Configuration (Staging)
MAGLABS_API_URL=https://staging-api.maglabs.com
MAGLABS_API_KEY=CHANGE_ME_STAGING_MAGLABS_API_KEY

# Frontend Configuration
FRONTEND_API_URL=https://staging.yourdomain.com/api
FRONTEND_WS_URL=wss://staging.yourdomain.com/ws

# AWS Configuration (Staging)
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=maglabs-staging-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=staging-cdn.yourdomain.com
AWS_CLOUDFRONT_DOMAIN=staging-cdn.yourdomain.com
USE_S3=true

# AWS RDS Configuration (Staging)
AWS_RDS_HOST=maglabs-staging.cluster-xyz.us-east-1.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DB_NAME=maglabs_staging
AWS_RDS_USERNAME=maglabs_staging
AWS_RDS_PASSWORD=CHANGE_ME_AWS_RDS_STAGING_PASSWORD

# AWS Region
AWS_DEFAULT_REGION=us-east-1

# Email Configuration (Staging - AWS SES)
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_SES_SMTP_USERNAME
EMAIL_HOST_PASSWORD=CHANGE_ME_SES_SMTP_PASSWORD
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@staging.yourdomain.com
AWS_SES_REGION_NAME=us-east-1

# Monitoring and Error Tracking (Staging)
SENTRY_DSN=CHANGE_ME_STAGING_SENTRY_DSN_URL
FRONTEND_SENTRY_DSN=CHANGE_ME_STAGING_FRONTEND_SENTRY_DSN

# AWS X-Ray Tracing
AWS_XRAY_TRACING_NAME=maglabs-staging

# Primary Domain for Multi-tenant
PRIMARY_DOMAIN=staging.yourdomain.com

# AWS ALB DNS (Staging)
AWS_ALB_DNS=maglabs-staging-alb-123456789.us-east-1.elb.amazonaws.com

# Performance Settings (Lower for staging)
GUNICORN_WORKERS=2

# Security Settings (Same as production)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# Logging (More verbose for staging)
LOG_LEVEL=DEBUG

# Multi-tenant Staging Domains
TENANT_DOMAINS=tenant1.staging.yourdomain.com,tenant2.staging.yourdomain.com,demo.staging.yourdomain.com

# Rate Limiting (More permissive for testing)
RATE_LIMIT_ENABLE=true
RATE_LIMIT_PER_MINUTE=200

# Staging-specific settings
ENABLE_STAGING_FEATURES=true
STAGING_DATA_RESET_ENABLED=true
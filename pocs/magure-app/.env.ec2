# EC2 Environment Configuration
# Copy this file and update with your actual values

# Environment
ENVIRONMENT=production
DEBUG=false

# Database Configuration
DB_NAME=maglabs_prod
DB_USER=maglabs_user
DB_PASSWORD=your-secure-database-password-here
DB_HOST=postgres
DB_PORT=5432

# Domain Configuration (IMPORTANT: Update with your actual domain)
DOMAIN_NAME=your-domain.com

# Django Settings
SECRET_KEY=your-very-long-and-secure-secret-key-here-50-characters-minimum
ALLOWED_HOSTS=localhost,127.0.0.1,${DOMAIN_NAME},*.${DOMAIN_NAME},api.${DOMAIN_NAME},admin.${DOMAIN_NAME}

# CORS Configuration (supports subdomains)
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,http://${DOMAIN_NAME},https://${DOMAIN_NAME},https://api.${DOMAIN_NAME},https://admin.${DOMAIN_NAME},https://*.${DOMAIN_NAME}

# MagLabs AI API Configuration
MAGLABS_API_URL=http://localhost:8001
MAGLABS_API_KEY=your-maglabs-api-key-here

# Frontend Configuration (uses domain variable)
FRONTEND_API_URL=https://${DOMAIN_NAME}/api
FRONTEND_WS_URL=wss://${DOMAIN_NAME}/ws

# Email Configuration (optional - use your SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# File Storage (local for EC2)
USE_S3=false

# Logging
LOG_LEVEL=INFO


# Multi-tenant Configuration
TENANT_DOMAINS=${DOMAIN_NAME},*.${DOMAIN_NAME}

# SSL Configuration (for production)
SSL_ENABLED=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Session Security
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
Project GenAI_Ideation_Platform {
  database_type: "PostgreSQL"
}

Enum user_role {
  magure_admin
  tenant_admin
  ideator
  c_suite
}

Table tenants {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar
  domain varchar [unique]
  logo_url varchar
  branding jsonb
  created_at timestamp
  updated_at timestamp
}

Table users {
  id uuid [pk, default: `uuid_generate_v4()`]
  first_name varchar
  last_name varchar
  middle_name varchar
  email varchar [unique]
  role user_role
  tenant_id uuid [ref: > tenants.id]
  created_at timestamp
  updated_at timestamp
}

Table ideas {
  id uuid [pk, default: `uuid_generate_v4()`]
  title varchar
  description text
  user_id uuid [ref: > users.id]
  tenant_id uuid [ref: > tenants.id]
  status varchar
  created_at timestamp
  updated_at timestamp
}

Table idea_refinements {
  id uuid [pk, default: `uuid_generate_v4()`]
  idea_id uuid [ref: > ideas.id]
  conversation jsonb
  refined_text text
  created_at timestamp
}

Table idea_scores {
  id uuid [pk, default: `uuid_generate_v4()`]
  idea_id uuid [ref: > ideas.id]
  clarity int
  value int
  complexity int
  scored_at timestamp
}

Table conversations {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [ref: > users.id]
  idea_id uuid [ref: > ideas.id, null]
  messages jsonb
  created_at timestamp
}

Table prompt_templates {
  id uuid [pk, default: `uuid_generate_v4()`]
  tenant_id uuid [ref: > tenants.id]
  type varchar
  title varchar
  prompt_text text
  created_at timestamp
  updated_at timestamp
}

Table submissions {
  id uuid [pk, default: `uuid_generate_v4()`]
  idea_id uuid [ref: > ideas.id]
  submitted_by uuid [ref: > users.id]
  submitted_at timestamp
  notes text
}

Table gamification_events {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [ref: > users.id]
  event_type varchar
  metadata jsonb
  created_at timestamp
}

Table ai_usage_logs {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [ref: > users.id]
  tenant_id uuid [ref: > tenants.id]
  prompt_type varchar
  token_count int
  created_at timestamp
}

Table features {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar [unique]
  description text
  created_at timestamp
}

Table tenant_features {
  id uuid [pk, default: `uuid_generate_v4()`]
  tenant_id uuid [ref: > tenants.id]
  feature_id uuid [ref: > features.id]
  enabled boolean
}

Table permissions {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar
  description text
  created_at timestamp
}

Table role_permissions {
  id uuid [pk, default: `uuid_generate_v4()`]
  role user_role
  permission_id uuid [ref: > permissions.id]
}
# AWS ALB configuration for multi-tenant routing
# Copy this file to aws.conf and update variables
# This config assumes SSL termination happens at ALB level

upstream backend_servers {
    server backend:8000 max_fails=3 fail_timeout=30s;
    keepalive 64;
}

upstream frontend_servers {
    server frontend:3000 max_fails=3 fail_timeout=30s;
    keepalive 64;
}

# Trust ALB IP ranges for real client IP
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Rate limiting for AWS deployment
limit_req_zone $binary_remote_addr zone=aws_api:20m rate=100r/s;
limit_req_zone $binary_remote_addr zone=aws_auth:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=aws_uploads:10m rate=10r/s;

# Map for tenant extraction from ALB headers or host
map $http_x_forwarded_host $tenant_from_alb {
    ~^(?<tenant>[^.]+)\.yourdomain\.com$ $tenant;
    default $tenant_from_host;
}

map $host $tenant_from_host {
    ~^(?<tenant>[^.]+)\.yourdomain\.com$ $tenant;
    ~^(?<tenant>[^.]+)\..*$ $tenant;
    default "public";
}

# Use ALB-forwarded host if available, otherwise use direct host
map $http_x_forwarded_host $final_tenant {
    "" $tenant_from_host;
    default $tenant_from_alb;
}

# Health check server for ALB
server {
    listen 80;
    server_name localhost;
    
    # ALB health check endpoint
    location /health {
        access_log off;
        return 200 "nginx healthy\n";
        add_header Content-Type text/plain;
    }
    
    # ECS health check
    location /ecs-health {
        access_log off;
        return 200 "ecs ready\n";
        add_header Content-Type text/plain;
    }
}

# Main server block for AWS deployment
server {
    listen 80;
    server_name _;  # Accept all hostnames since ALB handles routing
    
    # Set tenant header from extracted value
    set $tenant_header $final_tenant;
    
    # Add AWS-specific headers
    add_header X-Served-By "nginx-$hostname" always;
    add_header X-Tenant-Name "$tenant_header" always;
    
    # Frontend routes
    location / {
        # Skip if this is an API or admin request
        if ($request_uri ~ ^/(api|admin|static|media)/) {
            break;
        }
        
        proxy_pass http://frontend_servers;
        proxy_set_header Host $http_x_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Tenant-Name $tenant_header;
        
        # ALB-specific headers
        proxy_set_header X-Amzn-Trace-Id $http_x_amzn_trace_id;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
        
        # Handle React Router
        try_files $uri $uri/ @frontend_fallback;
    }
    
    # Frontend fallback for React Router
    location @frontend_fallback {
        proxy_pass http://frontend_servers;
        proxy_set_header Host $http_x_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Tenant-Name $tenant_header;
        proxy_set_header X-Amzn-Trace-Id $http_x_amzn_trace_id;
    }
    
    # API routes
    location /api/ {
        limit_req zone=aws_api burst=200 nodelay;
        
        proxy_pass http://backend_servers;
        proxy_set_header Host $http_x_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Tenant-Name $tenant_header;
        
        # AWS-specific headers
        proxy_set_header X-Amzn-Trace-Id $http_x_amzn_trace_id;
        proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        # AWS ALB timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;  # Increased for AWS
        proxy_read_timeout 300s;
        
        # Buffering optimized for ALB
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 32 16k;
        proxy_busy_buffers_size 32k;
    }
    
    # File upload routes
    location /api/upload/ {
        limit_req zone=aws_uploads burst=20 nodelay;
        client_max_body_size 100M;  # Increased for AWS
        
        proxy_pass http://backend_servers;
        proxy_set_header Host $http_x_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Tenant-Name $tenant_header;
        proxy_set_header X-Amzn-Trace-Id $http_x_amzn_trace_id;
        
        # Disable buffering for large uploads
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Increased timeouts for AWS uploads
        proxy_connect_timeout 300s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
    
    # Admin routes
    location /admin/ {
        limit_req zone=aws_auth burst=40 nodelay;
        
        proxy_pass http://backend_servers;
        proxy_set_header Host $http_x_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Tenant-Name $tenant_header;
        proxy_set_header X-Amzn-Trace-Id $http_x_amzn_trace_id;
    }
    
    # WebSocket endpoint
    location /ws/ {
        proxy_pass http://backend_servers;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_x_forwarded_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Tenant-Name $tenant_header;
        proxy_set_header X-Amzn-Trace-Id $http_x_amzn_trace_id;
        
        # WebSocket timeouts for AWS
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 3600s;  # 1 hour for long-lived connections
    }
    
    # Static files - may be served by S3/CloudFront in production
    location /static/ {
        # Check if we should redirect to S3/CloudFront
        if ($http_x_use_s3 = "true") {
            return 302 https://${AWS_CLOUDFRONT_DOMAIN}$request_uri;
        }
        
        proxy_pass http://backend_servers;
        proxy_set_header Host $http_x_forwarded_host;
        proxy_set_header X-Tenant-Name $tenant_header;
        
        # Caching headers
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Vary "Accept-Encoding";
    }
    
    # Media files - may be served by S3/CloudFront in production
    location /media/ {
        # Check if we should redirect to S3/CloudFront
        if ($http_x_use_s3 = "true") {
            return 302 https://${AWS_CLOUDFRONT_DOMAIN}$request_uri;
        }
        
        proxy_pass http://backend_servers;
        proxy_set_header Host $http_x_forwarded_host;
        proxy_set_header X-Tenant-Name $tenant_header;
        
        expires 30d;
        add_header Cache-Control "public";
    }
    
    # Backend health check
    location /health/ {
        proxy_pass http://backend_servers;
        proxy_set_header X-Tenant-Name $tenant_header;
        access_log off;
    }
    
    # Frontend health check
    location /frontend-health {
        proxy_pass http://frontend_servers/health;
        access_log off;
    }
}

# Connection upgrade map for WebSockets
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}